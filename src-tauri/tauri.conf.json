{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "进程管理器",
  "mainBinaryName": "process-manager",
  "version": "1.0.0",
  "identifier": "com.local.procman",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "进程管理器 · Process & Port Inspector",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "本地进程与端口检视工具",
    "longDescription": "查看本机进程的名称、命令行、启动参数、监听端口与父子关系，支持按名称与端口过滤及结束进程/进程树。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "startMenuFolder": "进程管理器"
      }
    }
  }
}
