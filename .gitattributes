# 仓库内统一使用 LF，避免 Windows 上反复出现 "LF will be replaced by CRLF" 警告与无意义的换行改动
* text=auto eol=lf

# 二进制资源不做任何换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary

# 锁文件在 diff / 合并时按文本处理，且不要出现在语言统计里
pnpm-lock.yaml linguist-generated=true
Cargo.lock linguist-generated=true
